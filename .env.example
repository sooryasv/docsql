# --- Database (app role + separate read-only role used ONLY for LLM-generated SQL) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/docsql
ANALYTICS_READONLY_DATABASE_URL=postgresql://docsql_readonly:docsql_readonly@localhost:5432/docsql
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/docsql_test
TEST_ANALYTICS_READONLY_DATABASE_URL=postgresql://docsql_readonly:docsql_readonly@localhost:5432/docsql_test
USE_NULL_POOL=false

# --- Auth / CSRF ---
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRE_MINUTES=60
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000
ENABLE_DEMO_TOOLS=true

# --- Startup ---
RUN_SEED_ON_STARTUP=true
FRONTEND_DIST_DIR=

# --- LLM (MOCK_LLM=true is for CI/tests/plumbing only; never publish mock numbers as quality) ---
MOCK_LLM=true
GEMINI_API_KEY=
# Model IDs are env-driven. Verify against https://ai.google.dev/gemini-api/docs/deprecations before deploying.
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
MIN_COSINE_SIMILARITY=0.50

# --- Quotas / limits ---
DAILY_QUERY_LIMIT=20
GLOBAL_DAILY_QUERY_LIMIT=200
MAX_DOCS_PER_USER=5
SQL_TIMEOUT_MS=3000
SQL_MAX_ROWS=100
LLM_TIMEOUT_S=20
EMBED_TIMEOUT_S=15
REQUEST_DEADLINE_S=45
